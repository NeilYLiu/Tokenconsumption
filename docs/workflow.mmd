flowchart TD
  A([接单]) --> B{分类}
  B -->|问题咨询| Q["取证后回答<br/>不改代码"] --> Z
  B -->|开发| SZ{"分级"}
  B -->|修复| F1

  SZ -->|"S：不超过 3 个文件且方案唯一"| D1
  SZ -->|"M：超过 3 个文件或方案不唯一"| D1
  SZ -->|"L：跨模块、新子系统、迁移"| L0["拆里程碑<br/>每个里程碑按 M 走"] --> D1

  subgraph DEV["开发轨道"]
    direction TB
    D1["D1 澄清 + 验收标准<br/>主会话；有歧义一次问清<br/>产物：1 到 3 行可执行的验收标准"]
    D2["D2 定位 + 计划<br/>主会话；大范围搜索交搜索员<br/>M、L 写不超过 10 行计划"]
    D3["D3 小步实现<br/>主会话；写一块验证一块<br/>脚手架、格式化交给命令"]
    D4["D4 定向验证<br/>run-quiet；多条命令交测试执行员"]
    D1 --> D2 --> D3 --> D4
    D4 -->|失败| D3
  end

  subgraph FIX["修复轨道"]
    direction TB
    F1["F1 复现<br/>最小命令；有框架就写失败用例<br/>复现不了：报告并要信息，不盲改"]
    F2["F2 定位 + 根因假设<br/>栈追踪 → 搜索 → 读行段<br/>一句话写出根因与改动位置"]
    F3["F3 最小修改<br/>只改根因；回归测试算范围内<br/>不顺手重构"]
    F4["F4 定向验证<br/>复现命令 + 相关测试，run-quiet"]
    F5["F5 止损<br/>撤销无效修改 → 取一条新证据<br/>仍定位不了再升一档强度或模型"]
    F6["F6 回归<br/>相关模块测试"]
    F1 --> F2 --> F3 --> F4
    F4 -->|失败 1 次| F3
    F4 -->|连续 2 次失败| F5 --> F2
    F4 -->|通过| F6
  end

  D4 -->|验收标准全部通过| R
  F6 --> R{"触发评审？<br/>超过 3 个文件，或触及<br/>输入处理、鉴权、并发、文件/网络/子进程"}
  R -->|是| RV["评审员，只派 1 次<br/>查正确性 + 安全缺陷<br/>不查风格与性能"]
  RV -->|有缺陷| FX["只修缺陷本身<br/>重新定向验证"] --> R
  RV -->|无缺陷| E
  R -->|否| E

  subgraph END["共用收尾"]
    direction TB
    E["完整检查<br/>lint、类型、测试，run-quiet<br/>只在环境类失败时重跑 1 次"]
    E2["提交<br/>做了什么 / 为什么（修复写根因）/ 怎么验证"]
    E3["进度文件（长任务）<br/>已完成、下一步、验证命令<br/>无效修法及证据、子 agent 结论"]
    E4["回复用户<br/>结论 + 验收标准逐条通过情况<br/>不复述操作，不贴代码"]
    E --> E2 --> E3 --> E4
  end
  E4 --> Z([结束会话；新任务新开会话])

  BUDGET[/"轮数预算：S 15、M 50、L 每里程碑 50<br/>用尽即停：写进度文件、重新分级、报告"/]
  ROLES[/"角色与档位：主会话 = 主模型中档强度<br/>搜索员 = 小模型低强度，返回不超过 20 行<br/>测试执行员、评审员 = 中档，返回不超过 40 行<br/>同时最多 3 个子 agent"/]

  classDef main fill:#e8eefc,stroke:#4a5b9c,color:#1b2340
  classDef small fill:#e6f5e9,stroke:#3d7d4d,color:#173322
  classDef mid fill:#fff4d6,stroke:#9c7a1f,color:#3a2d08
  classDef gate fill:#fde8e8,stroke:#a33,color:#3d1414
  classDef note fill:#f4f4f4,stroke:#888,color:#333
  class D1,D2,D3,F2,F3,FX main
  class D4,F4,F6,E small
  class RV mid
  class B,SZ,R,F5 gate
  class BUDGET,ROLES,L0,Q,E2,E3,E4 note
